APP_NAME="Yandex Parser"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yandexparser
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,yandexparser.local

SEED_USER_NAME="Admin"
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=password

YANDEX_MAPS_STRATEGY=json
YANDEX_MAPS_REGION=ru
YANDEX_MAPS_TIMEOUT=15
# Проблема с SSL-сертификатом на локальном PHP: укажите путь к CA-бандлу или false
YANDEX_MAPS_VERIFY_SSL=true
YANDEX_MAPS_MAX_REVIEWS=600
YANDEX_MAPS_THROTTLE_MS=800
YANDEX_MAPS_THROTTLE_JITTER_MS=400
YANDEX_MAPS_HEADLESS_ENABLED=false
YANDEX_MAPS_REVIEWS_ENDPOINT=/maps/api/business/fetchReviews
YANDEX_MAPS_LOCALE=ru_RU
YANDEX_MAPS_RANKING=by_relevance_org
YANDEX_MAPS_MAX_PAGES=12
YANDEX_MAPS_RETRIES=3
YANDEX_MAPS_BACKOFF_BASE_MS=1000

VITE_APP_NAME="${APP_NAME}"
