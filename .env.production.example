# Пример production-окружения для delivery-пака.
# Скопировать в app/.env и заполнить реальные значения:
#   cp .env.production.example app/.env   (из каталога delivery/)
# Секреты (.env) никогда не коммитятся.

APP_NAME="Yandex Parser"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://example.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=yandexparser
DB_USERNAME=root
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=example.com
SESSION_DOMAIN=.example.com

SEED_USER_NAME="Admin"
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me

YANDEX_MAPS_STRATEGY=json
YANDEX_MAPS_REGION=ru
YANDEX_MAPS_TIMEOUT=15
YANDEX_MAPS_VERIFY_SSL=true
YANDEX_MAPS_MAX_REVIEWS=600
YANDEX_MAPS_THROTTLE_MS=800
YANDEX_MAPS_THROTTLE_JITTER_MS=400
YANDEX_MAPS_HEADLESS_ENABLED=false
YANDEX_MAPS_REVIEWS_ENDPOINT=/maps/api/business/fetchReviews
YANDEX_MAPS_LOCALE=ru_RU
YANDEX_MAPS_RANKING=by_relevance_org
YANDEX_MAPS_MAX_PAGES=12
YANDEX_MAPS_RETRIES=3
YANDEX_MAPS_BACKOFF_BASE_MS=1000
